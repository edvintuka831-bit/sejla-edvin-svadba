# =====================================================================
#  Šejla & Edvin · Wedding Memories – varijable okruženja
#  Na Netlifyju: Site configuration → Environment variables.
#  Lokalno: kopirajte u .env.local (ta datoteka se NE šalje na GitHub).
# =====================================================================

# --- JAVNO (ide u kod stranice – to je u redu i namjerno) -------------
# Supabase → Project Settings → Data API → Project URL
# ⚠ RUČNO: npr. https://<vaš-projekt>.supabase.co
VITE_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (može i stari "anon" ključ)
# ⚠ RUČNO
VITE_SUPABASE_PUBLISHABLE_KEY=
# Konačna javna adresa stranice (za QR kod). Ako se izostavi, koristi se adresa na kojoj je admin otvoren.
# ⚠ RUČNO nakon što odredite ime stranice, npr. https://sejla-edvin-uspomene.netlify.app
VITE_PUBLIC_SITE_URL=

# --- TAJNO (samo serverske funkcije – NIKAD s prefiksom VITE_) --------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# (može i stari "service_role" ključ). Na Netlifyju označite kao "Secret".
# ⚠ RUČNO
SUPABASE_SECRET_KEY=
# Proizvoljan dugačak nasumični tekst (sažetak IP adrese za ograničenje slanja)
# ⚠ RUČNO (preporučeno)
RATE_LIMIT_SECRET=

# --- OGRANIČENJA (nije obavezno; prikazane su zadane vrijednosti) ------
# MAX_IMAGE_MB=25
# MAX_VIDEO_MB=50              # Supabase Free plan: najviše 50
# MAX_FILES_PER_BATCH=20
# MAX_FILES_PER_HOUR=80        # po uređaju/mreži
# MAX_FILES_PER_DAY=250        # po uređaju/mreži
# MAX_FILES_GLOBAL_PER_DAY=4000
# MAX_WISHES_PER_HOUR=8
# STORAGE_LIMIT_MB=950         # Free plan = 1 GB ukupno; na Pro planu npr. 95000
