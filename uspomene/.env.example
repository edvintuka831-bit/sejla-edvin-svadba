# =====================================================================
#  Šejla & Edvin · Wedding Memories – varijable okruženja (Netlify)
#  Netlify → Site configuration → Environment variables.
#  Sve osim VITE_PUBLIC_SITE_URL je TAJNO: označite "Contains secret values".
#  Lokalno: kopirajte u .env.local (ta datoteka se NE šalje na GitHub).
# =====================================================================

# --- Cloudflare R2 (pohrana fotografija i videa) ----------------------
# ⚠ RUČNO: Cloudflare → R2 → Overview → Account ID (desno)
R2_ACCOUNT_ID=
# ⚠ RUČNO: ime bucketa, npr. sejla-edvin-uspomene
R2_BUCKET=
# ⚠ RUČNO: R2 → Manage API tokens → Create API token (Object Read & Write, samo ovaj bucket)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Ako je bucket napravljen s jurisdikcijom "European Union (EU)", upišite: eu
R2_JURISDICTION=

# --- Administratori (postavljate privatno, najmanje 12 znakova) -------
# ⚠ RUČNO
ADMIN_SEJLA_PASSWORD=
# ⚠ RUČNO
ADMIN_EDVIN_PASSWORD=
# ⚠ RUČNO: dugačak nasumični tekst, najmanje 32 znaka (potpis prijave)
SESSION_SECRET=

# --- Javno ------------------------------------------------------------
# ⚠ RUČNO nakon što odredite ime stranice (za QR kartice), npr. https://sejla-edvin-uspomene.netlify.app
VITE_PUBLIC_SITE_URL=

# --- Ograničenja (nije obavezno; prikazane su zadane vrijednosti) ------
# STORAGE_LIMIT_GB=9           # 9 GB = ostaje u besplatnih 10 GB (0 $). Npr. 40 ≈ 0,45 $/mjesečno.
# MAX_VIDEO_MB=200
# MAX_IMAGE_MB=30
# MAX_FILES_PER_BATCH=20
# MAX_FILES_PER_HOUR=80        # po uređaju/mreži
# MAX_FILES_PER_DAY=250        # po uređaju/mreži
# MAX_GB_PER_DAY_PER_GUEST=3
# MAX_FILES_GLOBAL_PER_DAY=5000
# MAX_WISHES_PER_HOUR=8
